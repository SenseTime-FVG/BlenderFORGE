{
  "paths": {
    "blend_file": "base_scene.blend",
    "output_base_dir": "/replace/with/your/material_dataset"
  },
  "scene": {
    "target_object": "Sphere",
    "target_camera": "Camera",
    "target_material": "material_applied"
  },
  "material_modification": {
    "modification_type": "multi_param",
    "multi_param": {
      "min_params": 2,
      "max_params": 3
    },
    "parameters": {
      "Base Color": {
        "type": "color",
        "min": [
          0.0,
          0.0,
          0.0,
          1.0
        ],
        "max": [
          1.0,
          1.0,
          1.0,
          1.0
        ]
      },
      "Metallic": {
        "type": "float",
        "min": 0.0,
        "max": 1.0
      },
      "Roughness": {
        "type": "float",
        "min": 0.0,
        "max": 1.0
      },
      "Alpha": {
        "type": "float",
        "min": 0.0,
        "max": 1.0
      }
    }
  },
  "validation": {
    "min_photometric_diff": 0.01
  },
  "batch_generation": {
    "num_samples": 10,
    "start_sample_id": 0,
    "max_attempts": 5
  },
  "random_seed": 0,
