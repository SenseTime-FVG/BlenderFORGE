        "film_transparent": null,
        "use_file_extension": null,
        "use_compositing": null,
        "use_sequencer": null,
        "dither_intensity": null,
        "use_motion_blur": null,
        "image_settings": {
          "file_format": "PNG",
          "color_mode": null,
          "color_depth": null,
          "compression": null,
          "color_management": null
        }
      },
      "cycles": {
        "device": "GPU",
        "samples": 128,
        "seed": null,
        "use_animated_seed": null,
        "use_adaptive_sampling": null,
        "adaptive_threshold": null,
        "adaptive_min_samples": null,
        "use_denoising": true,
        "denoiser": null,
        "denoising_input_passes": null,
        "denoising_prefilter": null,
        "use_light_tree": null,
        "max_bounces": 4,
